# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채워넣으세요. (.env.local 은 git에 절대 커밋되지 않습니다)

# --- Spotify (트랙 메타데이터 조회 전용, 음원 파일 접근 없음) ---
# https://developer.spotify.com/dashboard 에서 앱 생성 후 발급
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 앱 설정 > Redirect URIs 에 정확히 아래 주소를 등록
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# --- Google (YouTube 업로드 + 나노바나나 이미지 생성) ---
# https://console.cloud.google.com 에서 프로젝트 생성 후
# 1) YouTube Data API v3 활성화 → OAuth 2.0 클라이언트 ID(데스크톱 앱) 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
# 2) Google AI Studio(https://aistudio.google.com/apikey) 에서 무료 API 키 발급 (나노바나나 = Gemini 2.5 Flash Image, 일 500장 무료)
GEMINI_API_KEY=

# --- Seedance (선택 사항, 유료: 초당 과금) ---
# fal.ai 또는 BytePlus 계정 발급 API 키. 비워두면 시덴스 생성 버튼이 비활성화됩니다.
SEEDANCE_API_KEY=
